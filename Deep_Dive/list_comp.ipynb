   "source": [
    "# Create a list of squares for the numbers from 0 through 9\n",
    "squares = [number ** 2 for number in range(10)]\n",
    "\n",
    "# Keep only the even squares\n",
    "even_squares = [square for square in squares if square % 2 == 0]\n",
    "\n",
    "print(even_squares)"
   ]
  }
 ],
