   "source": [
    "def my_func_deco(func):\n",
    "    def wrapper(x, y):\n",
    "        if x<y:\n",
    "            x,y = y,x\n",
    "            print(\"Values Swapped\")\n",
    "        func(x,y)\n",
    "        \n",
    "    return wrapper\n",
    "        \n",
    "\n",
    "@my_func_deco \n",
    "def origin(x, y):\n",
    "    print(x/y)\n",
    "\n",
    "\n",
    "print(origin(10,5))\n",
    "print(origin(5,10))"
   ]
  },
